# ─── Application ────────────────────────────────────────────────────────────
# Required in production. Change the default before deploying.
SECRET_KEY=change-me-before-deploying

# ─── Database ────────────────────────────────────────────────────────────────
# Set this in the Render dashboard (sync: false — never commit the real URL).
# Local default: SQLite in dev.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Encryption ─────────────────────────────────────────────────────────────
# Required in production to encrypt OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ─── QuickBooks Online OAuth ─────────────────────────────────────────────────
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=https://your-app.onrender.com/auth/qbo/callback

# ─── First-time admin bootstrap ─────────────────────────────────────────────
# These three variables are read ONCE at startup — only when the `users` table
# is completely empty.  Once any user exists in the database, they are ignored
# forever, so it is safe to leave them set after the first deploy.
#
# INITIAL_ADMIN_EMAIL  (required to bootstrap)
# INITIAL_ADMIN_PASSWORD  (required to bootstrap — stored as a bcrypt hash,
#                           never logged or exposed in any response)
# INITIAL_ADMIN_FULL_NAME  (optional — defaults to "Initial Admin")
#
# Usage:
#   1. Set the three vars in your Render environment before first deploy.
#   2. After the first successful login, you may remove them or leave them set.
#   3. Do NOT include real credentials in this file or commit them to git.
#
# INITIAL_ADMIN_EMAIL=admin@yourcompany.com
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_FULL_NAME=Initial Admin
